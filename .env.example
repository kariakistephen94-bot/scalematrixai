# Copy to .env.local and fill in your values. Never commit .env.local.
RESEND_API_KEY=
# Use a sender on your verified Resend domain.
RESEND_FROM_EMAIL=
# Inbox that should receive completed applications.
APPLICATION_TO_EMAIL=

# Comma-separated origins accepted by the application form.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://scalematrixai.com,https://scalematrixai.com,http://www.scalematrixai.com,https://www.scalematrixai.com
